{
  "mappings": [
    {
      "priority": 1,
      "request": { "method": "POST", "url": "/authorizations",
        "bodyPatterns": [ { "matchesJsonPath": "$[?(@.creditorAccount == 'ACC-70001')]" } ] },
      "response": { "status": 200, "headers": { "Content-Type": "application/json" },
        "jsonBody": { "decision": "DECLINED", "reason": "Creditor account flagged" } }
    },
    {
      "priority": 10,
      "request": { "method": "POST", "url": "/authorizations" },
      "response": { "status": 200, "headers": { "Content-Type": "application/json" },
        "jsonBody": { "decision": "APPROVED" } }
    }
  ]
}
